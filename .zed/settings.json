{
        "lsp": {
                "typescript-language-server": {
                        "settings": {
                                "typescript": {
                                        "tsdk": "node_modules/typescript/lib",
                                        "enablePromptUseWorkspaceTsdk": true
                                }
                        }
                },
                "tailwindcss-language-server": {
                        "settings": {
                                "tailwindCSS": {
                                        "includeLanguages": {
                                                "astro": "html"
                                        }
                                }
                        }
                }
        },

        "languages": {
                "TypeScript": {
                        "formatter": "prettier",
                        "format_on_save": "on"
                },
                "TSX": {
                        "formatter": "prettier",
                        "format_on_save": "on"
                },
                "JavaScript": {
                        "formatter": "prettier",
                        "format_on_save": "on"
                },
                "JSX": {
                        "formatter": "prettier",
                        "format_on_save": "on"
                },
                "CSS": {
                        "formatter": "prettier",
                        "format_on_save": "on"
                },
                "HTML": {
                        "formatter": "prettier",
                        "format_on_save": "on"
                },
                "Astro": {
                        "formatter": "prettier",
                        "format_on_save": "on"
                }
        },

        "file_scan_exclusions": [
                "**/node_modules/.pnpm",
                "**/.turbo",
                "**/storybook-static",
                "**/.astro"
        ]
}
