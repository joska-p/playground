{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": [
        "src/types.ts",
        "src/pixel-data.ts",
        "src/buffer-manager.ts",
        "src/fusion-scheduler.ts",
        "src/manipulation-factories.ts",
        "src/neighborhood-tiling.ts",
        "src/pipeline-runner.ts",
        "src/registry.ts",
        "src/step-dispatcher.ts",
        "src/manipulations/manifest.ts"
    ],
    "out": "dist-docs",
    "readme": "./README.md",
    "tsconfig": "./tsconfig.json",
    "theme": "hierarchy",
    "plugin": ["typedoc-theme-hierarchy", "typedoc-plugin-missing-exports"],
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "externalSymbolLinkMappings": {
        "@types/node": {
            "*": "#"
        }
    },
    "githubPages": false,
    "sort": ["kind", "alphabetical"]
}
