        "@tsconfig/strictest": "catalog:",
        "@types/babel__core": "catalog:",
        "@types/node": "catalog:",
        "@types/p5": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "babel-plugin-react-compiler": "catalog:",
        "eslint": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "tailwindcss": "catalog:",
