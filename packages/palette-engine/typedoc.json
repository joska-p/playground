{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": [
        "src/types.ts",
        "src/colorSpaces.ts",
        "src/generatePalette.ts",
        "src/rules/analogous.ts",
        "src/rules/complementary.ts",
        "src/rules/monochromatic.ts",
        "src/rules/triadic.ts"
    ],
    "out": "dist-docs",
    "readme": "./README.md",
    "tsconfig": "./tsconfig.json",
    "theme": "hierarchy",
    "plugin": ["typedoc-theme-hierarchy", "typedoc-plugin-missing-exports"],
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "externalSymbolLinkMappings": {
        "@types/node": {
            "*": "#"
        }
    },
    "githubPages": false,
    "sort": ["kind", "alphabetical"]
}
