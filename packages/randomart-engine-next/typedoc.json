{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": [
        "src/types.ts",
        "src/tree.ts",
        "src/prng.ts",
        "src/format.ts",
        "src/compileToGLSL.ts",
        "src/glsl-library.ts",
        "src/glsl-color-spaces.ts",
        "src/grammar/operators/registry.ts",
        "src/grammar/rules/registry.ts",
        "src/behaviors/registry.ts"
    ],
    "out": "dist-docs",
    "readme": "./README.md",
    "tsconfig": "./tsconfig.json",
    "theme": "hierarchy",
    "plugin": ["typedoc-theme-hierarchy", "typedoc-plugin-missing-exports"],
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "externalSymbolLinkMappings": {
        "@types/node": {
            "*": "#"
        }
    },
    "githubPages": false,
    "sort": ["kind", "alphabetical"]
}
