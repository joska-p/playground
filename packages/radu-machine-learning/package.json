{
    "name": "@repo/radu-machine-learning",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./radu-machine-learning": "./src/App.tsx",
        "./styles": "./src/styles/global.css"
    },
    "scripts": {
        "check-types": "tsc -b",
        "clean": "rm -rf node_modules dist .turbo",
        "dev": "vite --host",
        "extract-features": "pnpm exec node ./src/scripts/features-extractor.ts",
        "gen-dataset": "pnpm exec node ./src/scripts/dataset_generator.ts",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix",
        "preview": "vite preview --host"
    },
    "dependencies": {
        "@repo/ui": "workspace:*",
        "zustand": "catalog:"
    },
    "devDependencies": {
        "@babel/core": "catalog:",
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@rolldown/plugin-babel": "catalog:",
        "@tailwindcss/vite": "catalog:",
        "@types/babel__core": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "babel-plugin-react-compiler": "catalog:",
        "eslint": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:"
    },
    "peerDependencies": {
        "react": "catalog:",
        "react-dom": "catalog:"
    }
}
