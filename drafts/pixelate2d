## 5. React 19 Component & Hook Integration

### Battery-Included React 19 Components

```tsx
import { GpuCanvas } from '@pixelate2d/react';
import { drawCircle, drawText } from '@pixelate2d/core';

export function ArtStudio() {
  return (
    <div style={{ width: '100vw', height: '100vh' }}>
      <GpuCanvas
        pan
        zoom
        initialZoom={1.2}
        onFrame={(driver, { deltaTime, input, camera }) => {
          driver.clear('#0a0a0c');

          // Left-to-right reading flow
          drawCircle('#ffd700')(8)(input.getPointerWorldPos(camera))(driver);
          drawText('Pixelate2D GPU')('#ffffff')(16)({ x: 20, y: 30 })(driver);
        }}
      />
    </div>
  );
}

```

### Granular Manual Composition (Hooks)

```tsx
import { useRef } from 'react';
import { useCanvasDriver, useFrame, useCamera } from '@pixelate2d/react';
import { drawRect } from '@pixelate2d/core';

export function CustomCanvas() {
  const canvasRef = useRef<HTMLCanvasElement>(null);
  
  const driver = useCanvasDriver(canvasRef, { type: 'cpu' });
  const [camera, cameraControls] = useCamera({ zoom: 1 });

  // Subscribes directly to frame ticks without triggering React component re-renders
  useFrame(driver, ({ deltaTime }) => {
    if (!driver) return;
    driver.clear('#111');
    
    drawRect('#00ffcc')({ w: 100, h: 100 })({ x: 50, y: 50 })(driver);
  });

  return <canvas ref={canvasRef} {...cameraControls.bindGestures()} />;
}

```

