{
    "name": "playground",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "check-types": "pnpm clean:tsbuildinfo && turbo run check-types",
        "clean": "pnpm clean:packages && pnpm clean:turbo && pnpm clean:dist && pnpm clean:tsbuildinfo && pnpm clean:docs && pnpm clean:modules",
        "clean:dist": "find . -name node_modules -type d -prune -o -name dist -type d -prune -exec rm -rf {} +",
        "clean:docs": "rm -rf codex/ateliers/typedoc-pipeline/.generated",
        "clean:modules": "find . -name node_modules -type d -prune -exec rm -rf {} +",
        "clean:packages": "pnpm -r --if-present run clean",
        "clean:tsbuildinfo": "find . -name '*.tsbuildinfo' -type f -not -path '*/node_modules/*' -delete",
        "clean:turbo": "find . -name node_modules -type d -prune -o -name .turbo -type d -prune -exec rm -rf {} + && rm -rf node_modules/.cache/turbo",
        "dev": "turbo run dev",
        "format": "prettier --write .",
        "gen": "turbo gen",
        "gen:new-package": "turbo gen run new-package",
        "gen:project-pages": "turbo gen project-pages",
        "lint": "turbo run lint",
        "lint-fix": "turbo run lint-fix",
        "reset": "pnpm clean && pnpm install && pnpm verify",
        "verify": "pnpm lint-fix && pnpm check-types && pnpm format && pnpm build"
    },
    "dependencies": {
        "fallow": "^3.14.0",
        "tsx": "^4.23.8"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@turbo/gen": "catalog:",
        "@types/node": "catalog:",
        "prettier": "catalog:",
        "prettier-plugin-astro": "catalog:",
        "prettier-plugin-embed": "catalog:",
        "prettier-plugin-glsl": "catalog:",
        "prettier-plugin-jsdoc": "catalog:",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-tailwindcss": "catalog:",
        "turbo": "catalog:",
        "typedoc": "catalog:",
        "typescript": "catalog:",
        "yaml": "catalog:"
    },
    "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
