{
    "name": "playground",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "build:docs": "turbo run build:docs",
        "collect-assets": "node ./scripts/collect-static-assets.mjs",
        "deploy": "pnpm build && pnpm build:docs && pnpm collect-assets",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "lint-fix": "turbo run lint-fix",
        "format": "prettier --write .",
        "check-types": "turbo run check-types",
        "clean:turbo": "turbo run clean && rm -rf dist packages/*/.turbo",
        "clean:modules": "find . -name node_modules -type d -prune -exec rm -rf {} +",
        "clean:dist": "rm -rf dist packages/*/dist",
        "clean:docs": "rm -rf dist-docs packages/*/dist-docs",
        "clean:all": "pnpm clean:turbo && pnpm clean:modules && pnpm clean:dist && pnpm clean:docs",
        "reset": "pnpm clean:all && pnpm i && pnpm format && pnpm lint-fix && pnpm check-types && pnpm build",
        "gen": "turbo gen",
        "gen:new-package": "turbo gen run new-package",
        "gen:project-pages": "turbo gen run project-pages",
        "fallow": "fallow",
        "graphify": "graphify update"
    },
    "devDependencies": {
        "@turbo/gen": "catalog:",
        "@types/node": "catalog:",
        "prettier": "catalog:",
        "prettier-plugin-astro": "catalog:",
        "prettier-plugin-embed": "catalog:",
        "prettier-plugin-glsl": "catalog:",
        "prettier-plugin-jsdoc": "catalog:",
        "prettier-plugin-organize-imports": "catalog:",
        "prettier-plugin-tailwindcss": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:",
        "yaml": "catalog:"
    },
    "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
    "dependencies": {
        "fallow": "^3.14.0",
        "tsx": "^4.23.8"
    }
}
