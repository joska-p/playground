---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';
{{#if hasApp}}
import { App } from '{{appImport}}';
{{/if}}

const packageName = '{{packageName}}';
---

<BaseLayout title="{{title}}" description="{{description}}" keywords="{{keywords}}">
    <Hero
        badgeText="{{#if hasApp}}Project{{else}}{{packageName}}{{/if}}"
        title="{{title}}"
        description="{{description}}"
        variant="ghost"
    />

    {{#if hasApp}}
    <section class="w-full">
        <App client:only="react" />
    </section>
    {{/if}}

    <PackageDoc packageName={packageName} />
</BaseLayout>
