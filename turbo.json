{
    "$schema": "https://v2-10-7.turborepo.dev/schema.json",
    "ui": "stream-with-experimental-timestamps",
    "tasks": {
        "build:docs": {
            "outputs": ["apps/playground/.generated/api-docs/**"],
            "inputs": [
                "$TURBO_ROOT$/typedoc.base.json",
                "$TURBO_ROOT$/scripts/build-docs.mjs",
                "$TURBO_ROOT$/packages/*/src/**",
                "$TURBO_ROOT$/packages/*/README.md",
                "$TURBO_ROOT$/packages/*/typedoc.json",
                "$TURBO_ROOT$/packages/*/tsconfig*.json"
            ]
        },
        "copy:radu": {
            "inputs": ["$TURBO_ROOT$/packages/radu-machine-learning/public/radu-img/**"],
            "outputs": ["public/radu-img/**"]
        },
        "copy:storybook": {
            "inputs": ["$TURBO_ROOT$/apps/storybook/storybook-static/**"],
            "outputs": ["dist/storybook/**"]
        },
        "build": {
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".astro/**", "dist/**", "public/**"]
        },
        "test": {
            "outputs": ["coverage/**", "playwright-report/**"]
        },
        "lint": {
            "inputs": ["src/**", "eslint.config.*", "tsconfig*.json"],
            "outputs": [".eslintcache"]
        },
        "lint-fix": {
            "inputs": ["src/**", "eslint.config.*", "tsconfig*.json"]
        },
        "check-types": {
            "inputs": [
                "src/**",
                "tsconfig.json",
                "tsconfig.app.json",
                "tsconfig.node.json",
                "tsconfig.worker.json"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "clean": {
            "cache": false
        }
    }
}
