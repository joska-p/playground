{
    "$schema": "https://v2-10-7.turborepo.dev/schema.json",
    "ui": "stream-with-experimental-timestamps",
    "tasks": {
        "build": {
            "dependsOn": ["^build", "build:docs"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".astro/**", "dist/**", "storybook-static/**"]
        },
        "build:docs": {
            "dependsOn": ["^build"],
            "inputs": [
                "$TURBO_ROOT$/typedoc.base.json",
                "$TURBO_ROOT$/typedoc.docs.json",
                "$TURBO_ROOT$/scripts/generate-docs.mjs",
                "$TURBO_ROOT$/packages/*/src/**",
                "$TURBO_ROOT$/packages/*/README.md",
                "$TURBO_ROOT$/packages/*/typedoc.json",
                "$TURBO_ROOT$/packages/*/tsconfig*.json"
            ],
            "outputs": ["src/content/api/**"]
        },
        "test": {
            "outputs": ["coverage/**", "playwright-report/**"]
        },
        "lint": {
            "inputs": ["src/**", "eslint.config.*", "tsconfig*.json"],
            "outputs": [".eslintcache"]
        },
        "lint-fix": {
            "inputs": ["src/**", "eslint.config.*", "tsconfig*.json"]
        },
        "check-types": {
            "inputs": [
                "src/**",
                "tsconfig.json",
                "tsconfig.app.json",
                "tsconfig.node.json",
                "tsconfig.worker.json"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "clean": {
            "cache": false
        }
    }
}
