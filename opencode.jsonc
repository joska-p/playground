{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "codegraph": {
            "type": "local",
            "command": ["codegraph", "serve", "--mcp"],
            "enabled": false
        }
    },
    "compaction": {
        "auto": true,
        "prune": true
    },
    "permission": {
        "edit": "allow",
        "read": "allow",
        "webfetch": "allow",
        "websearch": "deny",
        "external_directory": { "": "deny" },
        "doom_loop": "deny"
    }
}
