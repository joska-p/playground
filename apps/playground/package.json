{
    "name": "@repo/playground",
    "private": true,
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "copy:radu": "cp -r ../../packages/radu-machine-learning/public/radu-img ./public/radu-img",
        "generate-typedoc-json": "node ../../codex/ateliers/typedoc-pipeline/generate-typedoc-json.mjs",
        "build:generate-typedoc-json": "pnpm generate-typedoc-json",
        "prebuild": "pnpm run copy:radu && pnpm build:generate-typedoc-json",
        "build": "astro build",
        "dev": "astro dev --host",
        "preview": "astro preview --host",
        "astro": "astro",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix",
        "check-types": "tsc --noEmit && astro check",
        "clean": "rm -rf node_modules .astro dist .turbo public/radu-img"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.9",
