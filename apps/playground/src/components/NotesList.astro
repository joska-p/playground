---
import { getCollection } from 'astro:content';
import { SciFiCard } from '@repo/tlc/components/cards';
import { hashToColor } from '../utils/tag-colors';

const baseUrl = import.meta.env.BASE_URL || '/';
const notesBaseUrl = `${baseUrl}notes/`;

// Pages hors collection (routes statiques dans src/pages/notes/), liées manuellement.
type ManualNote = { id: string; title: string; description: string; date: string; cardId: string };

const MANUAL_NOTES: ManualNote[] = [
    {
        id: 'le-voyage',
        title: 'Le voyage d’un clic',
        description:
            'L’enchâssement d’une information, du clic humain à la trame Ethernet — huit enveloppes, une seule intention.',
        date: '2026-08-23',
        cardId: 'le-voyage'
    }
];

function stringToSeed(str: string): number {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
        const char = str.charCodeAt(i);
        hash = (hash << 5) - hash + char;
        hash = hash & hash;
    }
    return Math.abs(hash);
}

type CardNote = {
    id: string;
    title: string;
    description: string;
    date: Date;
    cardId: string;
};

const collectedNotes = (await getCollection('notes', ({ data }) => !data.draft)).map<CardNote>(
    (note) => ({
        id: note.id,
        title: note.data.title,
        description: note.data.description ?? 'NC',
        date: new Date(note.data.date),
        cardId: note.id.split('/')[0]
    })
);

const manualCards: CardNote[] = MANUAL_NOTES.map((note) => ({
    ...note,
    date: new Date(note.date)
}));

const cards = [...collectedNotes, ...manualCards].sort((a, b) => a.title.localeCompare(b.title));
---

<div class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-4">
    {
        cards.map((card) => {
            const noteUrl = `${notesBaseUrl}${card.id}/#main`;
            const seed = stringToSeed(card.title);
            const date = card.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            return (
                <a
                    href={noteUrl}
                    title={card.title}
                >
                    <SciFiCard
                        cardId={card.cardId}
                        cardTitle={card.description}
                        classification={card.title}
                        color={hashToColor(card.title)}
                        density={String(seed)}
                        resolution={date}
                        seed={seed}
                    />
                </a>
            );
        })
    }
</div>
