---
import { apiIndex } from '../../lib/apiIndex';

type Props = {
    pkg: string;
};

const { pkg } = Astro.props;

const pkgEntries = apiIndex.entries.filter((e) => e.package === pkg);
const overviewEntry = pkgEntries.find((e) => e.kind === 'package');
const modules = pkgEntries
    .filter((e) => e.kind === 'module')
    .sort((a, b) => (a.module ?? '').localeCompare(b.module ?? ''));
const internals = pkgEntries
    .filter((e) => e.kind === 'internal')
    .sort((a, b) => a.id.localeCompare(b.id));
---

<aside
    class="sticky top-24 hidden h-[calc(100vh-7rem)] w-60 shrink-0 flex-col overflow-y-auto md:flex"
>
    <nav
        aria-label="API Reference navigation"
        class="min-h-full flex-1 overflow-y-auto p-3"
    >
        <div class="space-y-5 py-1">
            <div>
                <p
                    class="text-muted-foreground/50 mb-1.5 px-2 py-1 text-[9px] font-bold tracking-wider uppercase"
                >
                    API Reference
                </p>
                <ul
                    class="space-y-0.5 pl-1.5"
                    id="api-nav-list"
                >
                    {
                        overviewEntry && (
                            <li>
                                <a
                                    data-target="overview"
                                    class="group text-muted-foreground hover:bg-muted hover:text-foreground flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-xs transition-all duration-150"
                                    href="#overview"
                                >
                                    <span class="bg-border group-hover:bg-muted-foreground/50 h-1 w-1 shrink-0 rounded-full transition-colors" />
                                    Overview
                                </a>
                            </li>
                        )
                    }
                    {
                        modules.map((mod) => (
                            <li>
                                <a
                                    data-target={mod.namespace}
                                    class="group text-muted-foreground hover:bg-muted hover:text-foreground flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-xs transition-all duration-150"
                                    href={`#${mod.namespace}`}
                                >
                                    <span class="bg-border group-hover:bg-muted-foreground/50 h-1 w-1 shrink-0 rounded-full transition-colors" />
                                    {mod.module}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
            {
                internals.length > 0 && (
                    <div>
                        <p class="text-muted-foreground/50 mb-1.5 px-2 py-1 text-[9px] font-bold tracking-wider uppercase">
                            Internals
                        </p>
                        <ul
                            class="space-y-0.5 pl-1.5"
                            id="api-nav-list"
                        >
                            {internals.map((item) => (
                                <li>
                                    <a
                                        data-target={item.namespace}
                                        class="group text-muted-foreground hover:bg-muted hover:text-foreground flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-xs transition-all duration-150"
                                        href={`#${item.namespace}`}
                                    >
                                        <span class="bg-border group-hover:bg-muted-foreground/50 h-1 w-1 shrink-0 rounded-full transition-colors" />
                                        {item.module ? `${item.module} (internal)` : 'Internal'}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )
            }
        </div>
    </nav>
</aside>

<script>
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const id = entry.target.id;
                    const links = document.querySelectorAll('nav a[data-target]');
                    links.forEach((link) => {
                        const target = link.getAttribute('data-target');
                        const span = link.querySelector('span');
                        if (target === id) {
                            link.classList.remove(
                                'text-muted-foreground',
                                'hover:bg-muted',
                                'hover:text-foreground'
                            );
                            link.classList.add('bg-primary/10', 'text-primary', 'font-semibold');
                            if (span) {
                                span.classList.remove(
                                    'bg-border',
                                    'group-hover:bg-muted-foreground/50'
                                );
                                span.classList.add('bg-primary');
                            }
                        } else {
                            link.classList.remove('bg-primary/10', 'text-primary', 'font-semibold');
                            link.classList.add(
                                'text-muted-foreground',
                                'hover:bg-muted',
                                'hover:text-foreground'
                            );
                            if (span) {
                                span.classList.remove('bg-primary');
                                span.classList.add(
                                    'bg-border',
                                    'group-hover:bg-muted-foreground/50'
                                );
                            }
                        }
                    });
                }
            });
        },
        { rootMargin: '-20% 0% -60% 0%' }
    );

    document.querySelectorAll('article[id], section[id]').forEach((el) => {
        observer.observe(el);
    });
</script>
