---
import { getCollection } from 'astro:content';

type Props = {
    pkg: string;
};

const { pkg } = Astro.props;

const pkgEntries = await getCollection('api', (entry) => entry.data.package === pkg);

const overviewEntry = pkgEntries.find((e) => e.data.kind === 'package');
const modules = pkgEntries
    .filter((e) => e.data.kind === 'module')
    .sort((a, b) => (a.data.module ?? '').localeCompare(b.data.module ?? ''));

const basePath = `/discoveries/${pkg.replace(/^@repo\//, '')}/`;

const modulePath = (module: string) =>
    module.replace(/\.mdx?$/, '').replace(/\//g, '-') || module;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.replace(/\/$/, '') === href.replace(/\/$/, '');
---

<aside
    class="sticky top-24 hidden h-[calc(100vh-7rem)] w-60 shrink-0 flex-col overflow-y-auto md:flex"
>
    <nav
        aria-label="API Reference navigation"
        class="min-h-full flex-1 overflow-y-auto p-3"
    >
        <div class="space-y-5 py-1">
            <div>
                <p
                    class="text-muted-foreground/50 mb-1.5 px-2 py-1 text-[9px] font-bold tracking-wider uppercase"
                >
                    API Reference
                </p>
                <ul class="space-y-0.5 pl-1.5">
                    {
                        overviewEntry && (
                            <li>
                                <a
                                    class:list={[
                                        'group flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-xs transition-all duration-150',
                                        isActive(basePath)
                                            ? 'bg-primary/10 text-primary font-semibold'
                                            : 'text-muted-foreground hover:bg-muted hover:text-foreground'
                                    ]}
                                    href={basePath}
                                >
                                    <span
                                        class:list={[
                                            'h-1 w-1 shrink-0 rounded-full transition-colors',
                                            isActive(basePath)
                                                ? 'bg-primary'
                                                : 'bg-border group-hover:bg-muted-foreground/50'
                                        ]}
                                    />
                                    Overview
                                </a>
                            </li>
                        )
                    }
                    {modules.map((mod) => {
                        const href = `${basePath}${modulePath(mod.data.module ?? mod.data.title)}/`;
                        return (
                            <li>
                                <a
                                    class:list={[
                                        'group flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-xs transition-all duration-150',
                                        isActive(href)
                                            ? 'bg-primary/10 text-primary font-semibold'
                                            : 'text-muted-foreground hover:bg-muted hover:text-foreground'
                                    ]}
                                    href={href}
                                >
                                    <span
                                        class:list={[
                                            'h-1 w-1 shrink-0 rounded-full transition-colors',
                                            isActive(href)
                                                ? 'bg-primary'
                                                : 'bg-border group-hover:bg-muted-foreground/50'
                                        ]}
                                    />
                                    {mod.data.module}
                                </a>
                            </li>
                        );
                    })}
                </ul>
            </div>
        </div>
    </nav>
</aside>
