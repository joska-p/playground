---
type Props = {
    entry?: any;
    pkg?: string;
};

const { entry } = Astro.props;

const linkBase =
    'group flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-xs transition-all duration-150';
const linkIdle = 'text-muted-foreground hover:bg-muted hover:text-foreground';
const dotBase = 'h-1 w-1 shrink-0 rounded-full transition-colors';
const dotIdle = 'bg-border group-hover:bg-muted-foreground/50';
---

<aside
    class="sticky top-24 hidden h-[calc(100vh-7rem)] w-60 shrink-0 flex-col overflow-y-auto md:flex"
>
    <nav
        aria-label="API Reference navigation"
        class="min-h-full flex-1 overflow-y-auto p-3"
    >
        <div class="space-y-5 py-1">
            <div>
                <p
                    class="text-muted-foreground/50 mb-1.5 px-2 py-1 text-[9px] font-bold tracking-wider uppercase"
                >
                    Reference
                </p>
                <ul
                    id="api-nav-list"
                    class="space-y-0.5 pl-1.5"
                >
                    <li>
                        <a
                            data-target="overview"
                            class:list={[linkBase, linkIdle]}
                            href="#overview"
                        >
                            <span class:list={[dotBase, dotIdle]}></span>
                            Overview
                        </a>
                    </li>
                    {
                        entry && entry.data.typedoc && (
                            <li>
                                <a
                                    data-target="api"
                                    class:list={[linkBase, linkIdle]}
                                    href="#api"
                                >
                                    <span class:list={[dotBase, dotIdle]} />
                                    API Reference
                                </a>
                            </li>
                        )
                    }
                </ul>
            </div>
        </div>
    </nav>
</aside>

<script>
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const id = entry.target.id;
                    const links = document.querySelectorAll('#api-nav-list a');
                    links.forEach((link) => {
                        const span = link.querySelector('span');
                        const isActive = link.getAttribute('data-target') === id;
                        link.classList.toggle('bg-primary/10', isActive);
                        link.classList.toggle('text-primary', isActive);
                        link.classList.toggle('font-semibold', isActive);
                        link.classList.toggle('text-muted-foreground', !isActive);
                        link.classList.toggle('hover:bg-muted', !isActive);
                        link.classList.toggle('hover:text-foreground', !isActive);
                        if (span) {
                            span.classList.toggle('bg-primary', isActive);
                            span.classList.toggle('bg-border', !isActive);
                            span.classList.toggle('group-hover:bg-muted-foreground/50', !isActive);
                        }
                    });
                }
            });
        },
        { rootMargin: '-20% 0% -60% 0%' }
    );

    document.querySelectorAll('article[id], section[id]').forEach((el) => {
        observer.observe(el);
    });
</script>
