---
import { getCollection } from 'astro:content';
import { SciFiCard } from '@repo/tlc/components/cards';
import { toBraille, toOgham, toCanadianSyllabics } from '../utils/format';
import { CARD_COLORS } from '../utils/palettes';

const baseUrl = import.meta.env.BASE_URL || '/';
const projectsBaseUrl = `${baseUrl}discoveries/`;
const allProjects = await getCollection('packages');
const sortedProjects = allProjects.sort((a, b) => a.data.title.localeCompare(b.data.title));

function stringToSeed(str: string): number {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
        const char = str.charCodeAt(i);
        hash = (hash << 5) - hash + char;
        hash = hash & hash;
    }
    return Math.abs(hash);
}
---

<div class="grid grid-cols-[repeat(auto-fill,minmax(340px,1fr))] gap-4">
    {
        sortedProjects.map((project) => {
            const packageDir = project.data.package.replace(/^@repo\//, '');
            const color = CARD_COLORS[stringToSeed(project.data.title) % CARD_COLORS.length];
            return (
                <a
                    href={`${projectsBaseUrl}${packageDir}/#main`}
                    title={project.data.title}
                >
                    <SciFiCard
                        cardId={toCanadianSyllabics.fromHash(project.data.package).substring(0, 8)}
                        cardTitle={project.data.title}
                        classification={project.data.description ?? project.data.title}
                        color={color}
                        density={toBraille
                            .fromHash(project.data.description ?? project.data.title)
                            .substring(0, 8)}
                        resolution={toOgham.fromHash(project.data.title).substring(0, 8)}
                        seed={stringToSeed(project.data.title)}
                    />
                </a>
            );
        })
    }
</div>
