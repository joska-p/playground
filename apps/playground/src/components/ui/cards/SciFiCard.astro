---
import { generateSciFiPaths } from '@repo/tlc/components/cards';

interface Props {
    seed: number;
    variant?: 'default' | 'primary' | 'secondary' | 'accent' | 'destructive';
    cardId?: string;
    cardTitle?: string;
    classification: string;
    density: string;
    resolution: string;
    href: string;
    className?: string;
}

const {
    seed,
    variant = 'primary',
    cardId = 'Sci-Fi card id',
    cardTitle = 'Sci-Fi card title',
    classification,
    density,
    resolution,
    href,
    className = ''
} = Astro.props;

const paths = generateSciFiPaths(seed);

const baseClass = 'relative aspect-square overflow-hidden border p-5 group transition-colors duration-300';

const variantClasses: Record<string, string> = {
    default: 'border-border bg-card hover:border-border/50',
    primary: 'border-primary/20 bg-primary/5 hover:border-primary/50',
    secondary: 'border-secondary/20 bg-secondary/5 hover:border-secondary/50',
    accent: 'border-accent/20 bg-accent/5 hover:border-accent/50',
    destructive: 'border-destructive/20 bg-destructive/5 hover:border-destructive/50'
};

const variantColors: Record<string, string> = {
    default: 'currentColor',
    primary: 'var(--primary)',
    secondary: 'var(--secondary)',
    accent: 'var(--accent)',
    destructive: 'var(--destructive)'
};

const strokeColor = variantColors[variant];
---
<a
    href={href}
    class={`${baseClass} ${variantClasses[variant]} ${className}`}
    title={cardTitle}
>
    <svg
        class="absolute inset-0 z-0 h-full w-full opacity-90 drop-shadow-[0_0_6px_currentcolor] transition-opacity group-hover:opacity-100"
        viewBox="0 0 300 300"
        preserveAspectRatio="none"
        style={{ color: strokeColor }}
    >
        <path
            d={paths.openPaths}
            fill="none"
            stroke="currentColor"
            stroke-width="0.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="snakePath"
        ></path>
        <path
            d={paths.closedPaths}
            fill="none"
            stroke="currentColor"
            stroke-width="0.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="snakePath"
        ></path>
        {
            paths.dots.map((dot: { cx: string; cy: string; r: string }) => (
                <circle
                    cx={dot.cx}
                    cy={dot.cy}
                    r={dot.r}
                    fill="currentColor"
                    class="animate-pulse"
                />
            ))
        }
    </svg>

    <div class="relative z-20 flex h-full flex-col justify-between">
        <div class="flex items-start justify-between gap-4">
            <span
                class="inline-flex items-center rounded-md border border-current bg-current/10 px-2 py-0.5 text-[10px] font-medium tracking-wider text-current uppercase"
            >
                {cardId}
            </span>
            <h3
                class="text-foreground border border-current px-2 py-1 text-base tracking-wider uppercase"
            >
                {cardTitle}
            </h3>
        </div>

        <div class="mt-auto">
            <p class="text-foreground mb-1.5 font-light tracking-tight">
                {classification}
            </p>
            <div
                class="text-muted-foreground mt-3 flex justify-between border-t border-current pt-3 text-sm tracking-wider"
            >
                <span>{resolution}</span>
                <span>{density}</span>
            </div>
        </div>
    </div>
</a>

<style>
    @keyframes snakeMove {
        from {
            stroke-dashoffset: 0;
        }
        to {
            stroke-dashoffset: -1100;
        }
    }
    .snakePath {
        stroke-dasharray: 1000 10;
        animation: snakeMove 60s linear infinite;
    }
</style>