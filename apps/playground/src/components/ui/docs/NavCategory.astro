---
import { getCollection } from 'astro:content';
import { hashToColor } from '../../../utils/tag-colors';
const baseUrl = import.meta.env.BASE_URL || '/';
const docsBaseUrl = `${baseUrl}docs/`;

type Props = {
    categoryName: string;
    currentPath: string;
};

const { categoryName, currentPath } = Astro.props;

function prettifyCategory(name: string): string {
    return name
        .split('-')
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
}

const categoryTitle = prettifyCategory(categoryName);
const docs = await getCollection('docs', (entry) => entry.id.split('/')[0] === categoryName);

// Check if this category contains the currently active article to auto-open it
const hasActiveArticle = docs.some((category) => {
    const docUrl = `${docsBaseUrl}${category.id}/`;
    return currentPath === docUrl || currentPath === docUrl.slice(0, -1);
});
---

<details
    class="group/category select-none"
    open={hasActiveArticle}
>
    <summary
        class="mb-1.5 flex cursor-pointer list-none items-center justify-between gap-2 px-2 py-1 outline-none [&::-webkit-details-marker]:hidden"
    >
        <div
            class="flex items-center gap-2"
            style={{
                '--variant-color': hashToColor(categoryName)
            }}
        >
            <span class="text-foreground-dim/50 text-xs font-bold uppercase">
                {categoryTitle}
            </span>
        </div>

        <svg
            class="text-foreground-dim/40 h-2.5 w-2.5 transition-transform duration-200 group-open/category:rotate-90"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M8.25 4.5l7.5 7.5-7.5 7.5"
                stroke-linecap="round"
                stroke-linejoin="round"
            ></path>
        </svg>
    </summary>

    <ul class="space-y-0.5 pl-1.5">
        {
            docs.map((doc) => {
                const docUrl = `${docsBaseUrl}${doc.id}/`;
                const isActive = currentPath === docUrl || currentPath === docUrl.slice(0, -1);

                return (
                    <li>
                        <a
                            aria-current={isActive ? 'page' : undefined}
                            class:list={[
                                'group flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-xs transition-all duration-150',
                                {
                                    'bg-primary/10 text-primary font-semibold': isActive,
                                    'text-foreground-dim hover:bg-surface hover:text-foreground':
                                        !isActive
                                }
                            ]}
                            href={docUrl}
                        >
                            <span
                                class:list={[
                                    'h-1 w-1 shrink-0 rounded-full transition-colors',
                                    {
                                        'bg-primary': isActive,
                                        'bg-border group-hover:bg-foreground-dim/50': !isActive
                                    }
                                ]}
                            />
                            {doc.data.title}
                        </a>
                    </li>
                );
            })
        }
    </ul>
</details>
