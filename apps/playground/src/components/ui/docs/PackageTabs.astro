---
type Props = {
    slug: string;
    active: 'overview' | 'api';
};

const { slug, active } = Astro.props;

const baseUrl = import.meta.env.BASE_URL || '/';
const overviewUrl = `${baseUrl}discoveries/${slug}/`;
const apiUrl = `${baseUrl}discoveries/${slug}/api/`;
---

<nav
    aria-label="Package navigation"
    class="border-border/40 mx-auto mb-8 flex max-w-4xl gap-4 border-b font-mono text-sm"
>
    <a
        href={overviewUrl}
        class:list={[
            'px-4 py-2 transition-all',
            active === 'overview'
                ? 'border-primary text-foreground border-b-2 font-bold'
                : 'text-foreground-dim hover:text-foreground'
        ]}
    >
        Overview
    </a>
    <a
        href={apiUrl}
        class:list={[
            'px-4 py-2 transition-all',
            active === 'api'
                ? 'border-primary text-foreground border-b-2 font-bold'
                : 'text-foreground-dim hover:text-foreground'
        ]}
    >
        API Reference
    </a>
</nav>
