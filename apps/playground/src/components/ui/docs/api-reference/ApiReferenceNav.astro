---
import type { CollectionEntry } from 'astro:content';
import { kindLabel } from './kind-labels';
import { extractAllSymbols, symbolId, pluralize } from './typedoc-utils';

type Props = {
    entry?: CollectionEntry<'api'> | undefined;
};

const { entry } = Astro.props;
const typedoc = entry?.data?.typedoc;

// Uses the same traversal as ApiReference.astro (via extractAllSymbols) to
// guarantee every nav link points to an anchor that actually exists in the
// rendered content, even when TypeDoc groups exports under
// Modules/Namespaces.
const symbols = typedoc ? extractAllSymbols(typedoc) : [];

const groupedMembers = symbols.reduce<Record<string, typeof symbols>>((acc, symbol) => {
    const label = kindLabel(symbol.kind);
    (acc[label] ??= []).push(symbol);
    return acc;
}, {});

const linkBase =
    'group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors duration-150';
const linkIdle = 'text-foreground-dim hover:bg-surface/60 hover:text-foreground';
const indicatorBase = 'h-1.5 w-1.5 shrink-0 rounded-full transition-colors';
const indicatorIdle = 'bg-border group-hover:bg-foreground-dim/60';
---

<aside
    class="sticky top-24 hidden h-[calc(100vh-7rem)] w-64 shrink-0 flex-col overflow-y-auto md:flex"
>
    <nav
        aria-label="API reference navigation"
        class="min-h-full flex-1 p-2"
    >
        <div class="space-y-8">
            {/* Main sections */}
            {
                entry && (
                    <div>
                        <span class="text-foreground-dim/60 block px-3 pb-2 text-xs font-bold tracking-widest uppercase">
                            Navigation
                        </span>
                        <ul class="space-y-1">
                            <li>
                                <a
                                    data-target="overview"
                                    class:list={[linkBase, linkIdle]}
                                    href={`${import.meta.env.BASE_URL}discoveries/${entry.id}/`}
                                >
                                    <span class:list={[indicatorBase, indicatorIdle]} />
                                    Overview
                                </a>
                            </li>
                            <li>
                                <a
                                    data-target="api"
                                    class:list={[linkBase, linkIdle]}
                                    href="#api"
                                >
                                    <span class:list={[indicatorBase, indicatorIdle]} />
                                    API Reference
                                </a>
                            </li>
                        </ul>
                    </div>
                )
            }

            {/* Symbols grouped by kind */}
            {
                Object.entries(groupedMembers).map(([kind, items]) => (
                    <div class="space-y-2">
                        <span class="text-foreground-dim/60 block px-3 text-xs font-bold tracking-widest uppercase">
                            {pluralize(kind)}
                        </span>
                        <ul class="border-border/40 ml-3 min-w-0 space-y-1 border-l-2 pl-2">
                            {items.map((item) => {
                                const targetId = symbolId(item.name);
                                return (
                                    <li class="min-w-0">
                                        <a
                                            data-target={targetId}
                                            class:list={[
                                                linkBase,
                                                linkIdle,
                                                'min-w-0 font-mono text-xs'
                                            ]}
                                            href={`#${targetId}`}
                                        >
                                            <span class:list={[indicatorBase, indicatorIdle]} />
                                            <span class="min-w-0 truncate">{item.name}</span>
                                        </a>
                                    </li>
                                );
                            })}
                        </ul>
                    </div>
                ))
            }
        </div>
    </nav>
</aside>

<script>
    function setupScrollSpy() {
        const links = document.querySelectorAll<HTMLAnchorElement>(
            'nav[aria-label="API reference navigation"] a[data-target]'
        );
        const targets = new Map<string, HTMLElement>();

        links.forEach((link) => {
            const targetId = link.getAttribute('data-target');
            if (targetId) {
                const el = document.getElementById(targetId);
                if (el) targets.set(targetId, el);
            }
        });

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;

                    const id = entry.target.id;
                    links.forEach((link) => {
                        // The first <span> in a link is always the
                        // indicator dot (see markup above), whether or not
                        // there is a second span for the symbol name.
                        const dot = link.querySelector('span');
                        const isActive = link.getAttribute('data-target') === id;

                        link.classList.toggle('bg-primary/10', isActive);
                        link.classList.toggle('text-primary', isActive);
                        link.classList.toggle('font-bold', isActive);
                        link.classList.toggle('text-foreground-dim', !isActive);

                        dot?.classList.toggle('bg-primary', isActive);
                        dot?.classList.toggle('bg-border', !isActive);
                    });
                });
            },
            { rootMargin: '-15% 0% -65% 0%', threshold: 0.1 }
        );

        targets.forEach((el) => observer.observe(el));
    }

    document.addEventListener('astro:page-load', setupScrollSpy);
    setupScrollSpy();
</script>
