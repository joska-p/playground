---
import { getEntry, render } from 'astro:content';
import ApiReference from './ApiReference.astro';
import ApiReferenceNav from './ApiReferenceNav.astro';

type Props = {
    packageName: string;
};

const { packageName } = Astro.props;
const pkgDir = packageName.replace('@repo/', '');
const entry = await getEntry('api', pkgDir);
const symbolIdMap = entry?.data?.typedoc?.symbolIdMap;
const hasReference = symbolIdMap && Object.keys(symbolIdMap).length > 0;
const { Content } = entry ? await render(entry) : { Content: null };
---

<div class="mx-auto flex max-w-7xl justify-center gap-12 px-6 py-10">
    {entry && hasReference && <ApiReferenceNav entry={entry} />}

    <div class="flex max-w-4xl min-w-0 flex-1 flex-col gap-12">
        {
            entry && Content && (
                <article
                    id="overview"
                    class="prose prose-playground bg-surface/5 text-foreground border-border/40 max-w-none rounded-xl border p-[clamp(1.5rem,3vw,2.5rem)] shadow-lg backdrop-blur-xs transition-all"
                >
                    <Content />
                </article>
            )
        }

        {
            entry && hasReference && (
                <article
                    id="api"
                    class="prose prose-playground bg-surface/5 text-foreground border-border/40 max-w-none rounded-xl border p-[clamp(1.5rem,3vw,2.5rem)] shadow-lg backdrop-blur-xs transition-all"
                >
                    <div class="text-primary mb-4 font-mono text-xs font-bold tracking-widest uppercase">
                        API Reference // Structured Model
                    </div>
                    <ApiReference typedoc={entry.data.typedoc} />
                </article>
            )
        }
    </div>
</div>
