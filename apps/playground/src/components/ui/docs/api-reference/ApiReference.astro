---
import type { JSONOutput } from 'typedoc';
import { kindLabel } from './kind-labels';
import { extractAllSymbols, commentOf, getText, formatType, symbolId } from './typedoc-utils';

type Props = {
    typedoc: JSONOutput.ProjectReflection;
};

const { typedoc } = Astro.props;
const symbols = extractAllSymbols(typedoc);
---

{
    symbols.length === 0 ? (
        <p class="text-foreground-dim text-base">No exported member found.</p>
    ) : (
        <div class="space-y-12">
            {symbols.map((symbol) => {
                const signature = symbol.signatures?.[0];
                const summary = commentOf(symbol)?.summary ?? commentOf(signature)?.summary;
                const blockTags = commentOf(symbol)?.blockTags ?? commentOf(signature)?.blockTags;
                const examples = blockTags?.filter((tag) => tag.tag === '@example') ?? [];

                return (
                    <article
                        id={symbolId(symbol.name)}
                        class="border-border/40 bg-surface/30 max-w-full scroll-mt-28 space-y-6 overflow-hidden rounded-xl border p-6 shadow-xs"
                    >
                        {/* Title & kind badge */}
                        <div class="border-border/30 flex flex-wrap items-center gap-3 border-b pb-4">
                            <span class="bg-primary/10 text-primary rounded-md px-2.5 py-1 font-mono text-xs font-bold tracking-wide uppercase">
                                {kindLabel(symbol.kind)}
                            </span>
                            <h3 class="text-foreground wrap-break-words min-w-0 font-mono text-xl font-bold tracking-tight">
                                {symbol.name}
                            </h3>
                        </div>

                        {/* Summary / docstring */}
                        {summary && summary.length > 0 && (
                            <p class="text-foreground/90 text-base leading-relaxed">
                                {getText(summary)}
                            </p>
                        )}

                        {/* Examples */}
                        {examples.length > 0 && (
                            <div class="space-y-2 pt-2">
                                <span class="text-foreground-dim text-xs font-bold tracking-widest uppercase">
                                    Example
                                </span>
                                {examples.map((example) => (
                                    <pre class="bg-surface/40 border-border/30 max-w-full overflow-x-auto rounded-lg border p-4 font-mono text-sm leading-relaxed">
                                        <code>{getText(example.content)}</code>
                                    </pre>
                                ))}
                            </div>
                        )}

                        {/* Members / methods (classes and interfaces) */}
                        {symbol.children && symbol.children.length > 0 && (
                            <div class="space-y-4 pt-4">
                                <h4 class="text-foreground border-border/20 border-b pb-2 text-sm font-bold tracking-wider uppercase">
                                    Members & Methods ({symbol.children.length})
                                </h4>
                                <div class="space-y-4">
                                    {symbol.children.map((member) => {
                                        const memSig = member.signatures?.[0];
                                        const memSummary =
                                            commentOf(member)?.summary ??
                                            commentOf(memSig)?.summary;

                                        return (
                                            <div class="bg-surface/20 border-border/20 min-w-0 space-y-2 rounded-lg border p-4 font-mono">
                                                <div class="flex min-w-0 flex-wrap items-baseline gap-x-2 gap-y-1">
                                                    <span class="text-foreground-dim text-xs font-semibold">
                                                        [{kindLabel(member.kind)}]
                                                    </span>
                                                    <span class="text-foreground wrap-break-words text-sm font-bold">
                                                        {member.name}
                                                    </span>
                                                    {member.type && (
                                                        <span class="text-primary wrap-break-words min-w-0 text-xs">
                                                            : {formatType(member.type)}
                                                        </span>
                                                    )}
                                                </div>

                                                {/* Parameters (method / function) */}
                                                {memSig?.parameters &&
                                                    memSig.parameters.length > 0 && (
                                                        <div class="text-foreground-dim border-border/40 min-w-0 border-l-2 pl-4 text-xs">
                                                            <span class="text-foreground font-semibold">
                                                                Parameters:
                                                            </span>
                                                            <ul class="mt-1 list-disc space-y-1 pl-4">
                                                                {memSig.parameters.map((param) => (
                                                                    <li class="wrap-break-words">
                                                                        <span class="text-foreground font-semibold">
                                                                            {param.name}
                                                                        </span>
                                                                        {param.type && (
                                                                            <span>
                                                                                :{' '}
                                                                                {formatType(
                                                                                    param.type
                                                                                )}
                                                                            </span>
                                                                        )}
                                                                    </li>
                                                                ))}
                                                            </ul>
                                                        </div>
                                                    )}

                                                {/* Member comment */}
                                                {memSummary && memSummary.length > 0 && (
                                                    <p class="text-foreground-dim pt-1 font-sans text-xs">
                                                        {getText(memSummary)}
                                                    </p>
                                                )}
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        )}
                    </article>
                );
            })}
        </div>
    )
}
