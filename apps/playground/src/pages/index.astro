---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Hero } from '@repo/tlc/components/display';
import ProjectsList from '../components/ProjectsList.astro';
import NotesList from '../components/NotesList.astro';
import DocumentsList from '../components/DocumentsList.astro';
import { toCanadianSyllabics } from '../utils/format';

const highlight = toCanadianSyllabics.fromHash('Recreational Programming');
---

<BaseLayout title="Cahier d'exercices">
    <Hero
        highlight={highlight}
        title="Cahier d'exercices"
        variant="ghost"
    />

    <section
        class="mx-auto mb-24 w-full max-w-6xl px-6 py-20 lg:py-24"
        id="discoveries"
    >
        <ProjectsList />
    </section>

    <section
        class="mx-auto mb-24 w-full max-w-6xl px-6 py-20 lg:py-24"
        id="notes"
    >
        <NotesList />
    </section>

    <section
        class="mx-auto mb-24 w-full max-w-6xl px-6 py-20 lg:py-24"
        id="documents"
    >
        <DocumentsList />
    </section>
</BaseLayout>
