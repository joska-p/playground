---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from '@repo/tlc/components/icons';
import { Hero } from '@repo/tlc/components/display';
import { buttonVariants } from '@repo/tlc/components/forms';

const baseUrl = import.meta.env.BASE_URL || '/';
const projectsBaseUrl = `${baseUrl}#atlas`;
---

<BaseLayout title="404 — Not Found">
    <Hero
        badgeText="Lost in the woods"
        description="You've ventured into the void. This page doesn't exist — perhaps it was lost in the multiverse, or maybe it never was."
        highlight="404"
        title="PAGE NOT FOUND"
    >
        <a
            class:list={[
                buttonVariants({ variant: 'primary' }) + '',
                'shadow-primary/20 hover:shadow-primary/30 h-10 rounded-full px-6 text-xs uppercase shadow-lg hover:-translate-y-0.5 hover:shadow-xl'
            ]}
            href={`${baseUrl}`}
        >
            <Icon
                className="h-3.5 w-3.5"
                name="home"
            />
            Go Home
        </a>
        <a
            class="border-border/50 text-foreground-dim hover:border-primary/40 hover:bg-surface/30 hover:text-primary inline-flex h-10 items-center gap-2 rounded-full border-2 bg-transparent px-6 text-xs font-bold uppercase transition-all duration-300 hover:-translate-y-0.5 active:scale-95"
            href={projectsBaseUrl}
        >
            All Projects
        </a>
    </Hero>
</BaseLayout>
