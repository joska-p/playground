---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';
import { App } from '@repo/palette-generator/palette-generator';

const packageName = '@repo/palette-generator';
---

<BaseLayout title="Palettes Generator" description="Generate harmonious color schemes using mathematical color theory models." keywords="color, design, theory">
    <Hero
        badgeText="Project"
        title="Palettes Generator"
        description="Generate harmonious color schemes using mathematical color theory models."
        variant="ghost"
    />

    <section class="w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
