---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/api/PackageDoc.astro';
import { App } from '@repo/palette-generator/palette-generator';

const packageName = '@repo/palette-generator';
---

<BaseLayout
    title="Palettes Generator"
    description="Generate harmonious color schemes using mathematical color theory models."
    keywords="color, design, theory"
>
    <section class="min-h-screen w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
