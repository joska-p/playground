---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/ui/docs/api-reference/PackageDoc.astro';
import { App } from '@repo/l-system/l-system';

const packageName = '@repo/l-system';
---

<BaseLayout
    title="L-System"
    description="An L-system (Lindenmayer system) 3D visualizer with interactive turtle graphics."
    keywords="generative, three-js, 3d, webgl, simulation"
>
    <section class="min-h-screen w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
