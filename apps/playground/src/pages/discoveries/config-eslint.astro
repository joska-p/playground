---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';

const packageName = '@repo/config-eslint';
---

<BaseLayout title="ESLint Config" description="Workspace ESLint configuration package for TypeScript and React." keywords="config, infrastructure">
    <Hero
        badgeText="@repo/config-eslint"
        title="ESLint Config"
        description="Workspace ESLint configuration package for TypeScript and React."
        variant="ghost"
    />


    <PackageDoc packageName={packageName} />
</BaseLayout>
