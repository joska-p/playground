---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/api/PackageDoc.astro';
import { App } from '@repo/art-canvas/art-canvas';

const packageName = '@repo/art-canvas';
---

<BaseLayout
    title="Art canvas"
    description='Create "art" in the canvas using shaders and logarithmic.'
    keywords="random, webgl"
>
    <section class="min-h-screen w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
