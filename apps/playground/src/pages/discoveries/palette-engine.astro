---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';

const packageName = '@repo/palette-engine';
---

<BaseLayout title="Palette Engine" description="Pure engine mapping base colors to harmonious palettes across OKLab, OKLCh, HSL, and sRGB color spaces." keywords="color, design, engine, theory">
    <Hero
        badgeText="@repo/palette-engine"
        title="Palette Engine"
        description="Pure engine mapping base colors to harmonious palettes across OKLab, OKLCh, HSL, and sRGB color spaces."
        variant="ghost"
    />


    <PackageDoc packageName={packageName} />
</BaseLayout>
