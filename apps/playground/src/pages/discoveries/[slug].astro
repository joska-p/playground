---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PackageAppHost } from '../../components/discoveries/PackageAppHost.tsx';
import PackageTabs from '../../components/ui/docs/PackageTabs.astro';

export async function getStaticPaths() {
    const packagesEntries = await getCollection('packages');
    return packagesEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry }
    }));
}

const { entry } = Astro.props;

// Render README content (overview)
const { Content } = await render(entry);

const keywords = entry.data.keywords?.join(', ') || '';
const hasReference = entry.data.hasReference;
---

<BaseLayout
    title={entry.data.title}
    description={entry.data.description}
    keywords={keywords}
>
    {
        entry.data.hasApp && (
            <section class="relative min-h-screen w-full">
                <PackageAppHost
                    appId={entry.id}
                    client:only="react"
                />
            </section>
        )
    }

    <div class="mx-auto max-w-4xl px-6 py-10">
        {
            hasReference && (
                <PackageTabs
                    slug={entry.id}
                    active="overview"
                />
            )
        }

        {
            Content && (
                <article
                    id="overview"
                    class="prose prose-playground bg-surface/5 text-foreground border-border/40 max-w-none rounded-xl border p-[clamp(1.5rem,3vw,2.5rem)] shadow-lg backdrop-blur-xs transition-all"
                >
                    <Content />
                </article>
            )
        }
    </div>
</BaseLayout>
