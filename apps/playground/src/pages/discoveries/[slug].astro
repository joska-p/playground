---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PackageAppHost } from '../../components/PackageAppHost';
import ApiReference from '../../components/ui/docs/api-reference/ApiReference.astro';

export async function getStaticPaths() {
    const packagesEntries = await getCollection('packages');
    return packagesEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry }
    }));
}

const { entry } = Astro.props;

// Render README content (overview)
const { Content } = await render(entry);

const keywords = entry.data.keywords?.join(', ') || '';
const hasReference = entry.data.hasReference;
---

<BaseLayout
    title={entry.data.title}
    description={entry.data.description}
    keywords={keywords}
>
    {
        entry.data.hasApp && (
            <section class="relative min-h-screen w-full">
                <PackageAppHost
                    appId={entry.id}
                    client:only="react"
                />
            </section>
        )
    }

    <article
        id="overview"
        class="prose prose-playground bg-surface/5 text-foreground border-border/40 mx-auto max-w-4xl scroll-mt-28 rounded-xl border p-[clamp(1.5rem,3vw,2.5rem)] shadow-lg backdrop-blur-xs transition-all"
    >
        {Content && <Content />}
    </article>

    {
        hasReference && (
            <section
                id="api"
                class="mx-auto max-w-4xl scroll-mt-28 px-6 py-16"
            >
                <h2 class="text-foreground mb-8 text-2xl font-bold tracking-tight">
                    API Reference
                </h2>
                <ApiReference typedoc={entry.data.typedoc} />
            </section>
        )
    }
</BaseLayout>
