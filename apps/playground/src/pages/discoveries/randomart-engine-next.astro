---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';

const packageName = '@repo/randomart-engine-next';
---

<BaseLayout
    title="RandomArt Engine Next"
    description="Next-generation expression tree engine with subpath registries for operators, rules, behaviors, and color spaces."
    keywords="generative, canvas, engine, shader"
>
    <Hero
        badgeText="@repo/randomart-engine-next"
        title="RandomArt Engine Next"
        description="Next-generation expression tree engine with subpath registries for operators, rules, behaviors, and color spaces."
        variant="ghost"
    />

    <PackageDoc packageName={packageName} />
</BaseLayout>
