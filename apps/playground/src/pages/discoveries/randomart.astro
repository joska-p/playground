---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { App } from '@repo/randomart/randomart';

const project = await getEntry('projects', 'randomart');
if (!project) return Astro.redirect('/404');

const { title, description } = project.data;
const keywords = project.data.tags?.join(', ').slice(1) || '';
---

<BaseLayout
  description={description}
  keywords={keywords}
  title={title}
>
  <div class="h-0 min-h-screen">
    <App client:only="react" />
  </div>
</BaseLayout>
