---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';
import { App } from '@repo/randomart/randomart';

const packageName = '@repo/randomart';
---

<BaseLayout
    title="RandomArt"
    description="Generate unique abstract art from any text string using seeded randomness and math expression trees."
    keywords="generative, canvas"
>
    <Hero
        badgeText="Project"
        title="RandomArt"
        description="Generate unique abstract art from any text string using seeded randomness and math expression trees."
        variant="ghost"
    />

    <section class="w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
