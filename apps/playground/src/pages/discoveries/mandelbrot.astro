---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/api/PackageDoc.astro';
import { App } from '@repo/mandelbrot';

const packageName = '@repo/mandelbrot';
---

<BaseLayout
    title="Mandelbrot Explorer"
    description="Deep-zoom Mandelbrot explorer built on perturbation theory with arbitrary-precision BigInt reference orbits."
    keywords="generative, webgl, math, 2d, shader"
>
    <section class="w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
