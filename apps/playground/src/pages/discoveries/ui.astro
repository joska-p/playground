---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';
import { App } from '@repo/ui/ui';

const packageName = '@repo/ui';
---

<BaseLayout
    title="Atlas"
    description="Cartographer's Toolkit"
    keywords="random, docs"
>
    <Hero
        badgeText="Project"
        title="Atlas"
        description="Cartographer's Toolkit"
        variant="ghost"
    />

    <section class="w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
