---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/ui/docs/api-reference/PackageDoc.astro';
import { App } from '@repo/image-to-particles/image-to-particles';

const packageName = '@repo/image-to-particles';
---

<BaseLayout
    title="Image to Particles"
    description="Deconstruct images into physics-based particle systems with real-time interaction."
    keywords="image, physics, canvas"
>
    <section class="min-h-screen w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
