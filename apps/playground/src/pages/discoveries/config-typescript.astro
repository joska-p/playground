---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';

const packageName = '@repo/config-typescript';
---

<BaseLayout
    title="TypeScript Config"
    description="Workspace shared tsconfig baselines for monorepo packages and apps."
    keywords="config, infrastructure"
>
    <Hero
        badgeText="@repo/config-typescript"
        title="TypeScript Config"
        description="Workspace shared tsconfig baselines for monorepo packages and apps."
        variant="ghost"
    />

    <PackageDoc packageName={packageName} />
</BaseLayout>
