---
import { getEntry, render } from 'astro:content';
import DiscoveryLayout from '../../layouts/DiscoveryLayout.astro';
const entry = await getEntry('packages', 'config-typescript');

if (!entry) {
    throw new Error(
        `Missing "packages" collection entry for "config-typescript" — run \`pnpm generate-typedoc-json\` first.`
    );
}

const { Content } = await render(entry);
---

<DiscoveryLayout entry={entry}>
    <Content />
</DiscoveryLayout>
