---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';
import { App } from '@repo/three-stage/three-stage';

const packageName = '@repo/three-stage';
---

<BaseLayout
    title="Three Stage"
    description="A 3D stage for rendering and animating 3D objects."
    keywords="random, three-js, 3d, webgl"
>
    <Hero
        badgeText="Project"
        title="Three Stage"
        description="A 3D stage for rendering and animating 3D objects."
        variant="ghost"
    />

    <section class="w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
