---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/ui/docs/api-reference/PackageDoc.astro';
import { App } from '@repo/pixel/docs';

const packageName = '@repo/pixel';
---

<BaseLayout
    title="Pixel"
    description="Interactive API documentation for the browser-based image manipulation pipeline with live visual examples."
    keywords="image, pipeline, docs"
>
    <section class="min-h-screen w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
