---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';

const packageName = '@repo/worker-pool';
---

<BaseLayout title="Worker Pool" description="Web Worker concurrency management library handling worker pooling, queuing, Transferable buffers, and teardown." keywords="infrastructure, worker-pool, webgl, pipeline">
    <Hero
        badgeText="@repo/worker-pool"
        title="Worker Pool"
        description="Web Worker concurrency management library handling worker pooling, queuing, Transferable buffers, and teardown."
        variant="ghost"
    />


    <PackageDoc packageName={packageName} />
</BaseLayout>
