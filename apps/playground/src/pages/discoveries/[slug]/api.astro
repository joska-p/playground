---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ApiReference from '../../../components/ui/docs/api-reference/ApiReference.astro';
import ApiReferenceNav from '../../../components/ui/docs/api-reference/ApiReferenceNav.astro';
import PackageTabs from '../../../components/ui/docs/PackageTabs.astro';

export async function getStaticPaths() {
    const packagesEntries = await getCollection('packages', ({ data }) => data.hasReference);
    return packagesEntries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry }
    }));
}

const { entry } = Astro.props;
const { slug } = Astro.params;

const keywords = entry.data.keywords?.join(', ') || '';
---

<BaseLayout
    title={`${entry.data.title} - API Reference`}
    description={`API Reference for ${entry.data.title}`}
    keywords={keywords}
>
    <div class="mx-auto max-w-7xl px-6 py-10">
        <PackageTabs
            slug={slug}
            active="api"
        />

        <div class="flex justify-center gap-12">
            <ApiReferenceNav entry={entry} />

            <div class="flex max-w-4xl min-w-0 flex-1 flex-col gap-12">
                <article
                    id="api"
                    class="prose prose-playground bg-surface/5 text-foreground border-border/40 max-w-none rounded-xl border p-[clamp(1.5rem,3vw,2.5rem)] shadow-lg backdrop-blur-xs transition-all"
                >
                    <div
                        class="text-primary mb-4 font-mono text-xs font-bold tracking-widest uppercase"
                    >
                        API Reference // Structured Model
                    </div>
                    <ApiReference typedoc={entry.data.typedoc} />
                </article>
            </div>
        </div>
    </div>
</BaseLayout>
