---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';
import { App } from '@repo/graph-viz/graph-viz';

const packageName = '@repo/graph-viz';
---

<BaseLayout
    title="Graphify"
    description="Interactive graph, click nodes, search, filter by community."
    keywords="data-viz, graph, d3"
>
    <Hero
        badgeText="Project"
        title="Graphify"
        description="Interactive graph, click nodes, search, filter by community."
        variant="ghost"
    />

    <section class="w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
