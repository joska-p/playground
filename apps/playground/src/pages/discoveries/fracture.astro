---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/ui/docs/api-reference/PackageDoc.astro';
import { App } from '@repo/fracture/fracture';

const packageName = '@repo/fracture';
---

<BaseLayout
    title="Fracture"
    description="Interactive fractal with WebGL rendering."
    keywords="generative, three-js, 3d, webgl"
>
    <section class="min-h-screen w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
