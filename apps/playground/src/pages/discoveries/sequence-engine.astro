---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';

const packageName = '@repo/sequence-engine';
---

<BaseLayout
    title="Sequence Engine"
    description="Pure rule-based mathematical sequence generation engine with persistence abstractions."
    keywords="generative, math, engine"
>
    <Hero
        badgeText="@repo/sequence-engine"
        title="Sequence Engine"
        description="Pure rule-based mathematical sequence generation engine with persistence abstractions."
        variant="ghost"
    />

    <PackageDoc packageName={packageName} />
</BaseLayout>
