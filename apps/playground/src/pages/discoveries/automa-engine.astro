---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';

const packageName = '@repo/automa-engine';
---

<BaseLayout
    title="Automa Engine"
    description="Pure simulation engine converting birth/survive lookup tables and multi-state rules into evolving cellular automata."
    keywords="simulation, engine, cellular-automata"
>
    <Hero
        badgeText="@repo/automa-engine"
        title="Automa Engine"
        description="Pure simulation engine converting birth/survive lookup tables and multi-state rules into evolving cellular automata."
        variant="ghost"
    />

    <PackageDoc packageName={packageName} />
</BaseLayout>
