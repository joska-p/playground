---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/ui/docs/api-reference/PackageDoc.astro';
import { App } from '@repo/radu-machine-learning/radu-machine-learning';

const packageName = '@repo/radu-machine-learning';
---

<BaseLayout
    title="Radu Machine Learning"
    description="Interactive machine learning visualizations — decision boundaries, sample distributions, and student model training."
    keywords="machine-learning, data-viz, canvas"
>
    <section class="min-h-screen w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
