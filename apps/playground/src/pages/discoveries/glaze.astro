---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';
import { App } from '@repo/glaze/docs/GlazeDocs';

const packageName = '@repo/glaze';
---

<BaseLayout title="Glaze" description="2D drawing immediacy and WebGL shader canvas framework with state buffer simulations and gestures." keywords="canvas, webgl, framework, 2d, shader">
    <Hero
        badgeText="Project"
        title="Glaze"
        description="2D drawing immediacy and WebGL shader canvas framework with state buffer simulations and gestures."
        variant="ghost"
    />

    <section class="w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
