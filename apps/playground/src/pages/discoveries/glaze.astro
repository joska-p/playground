---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';
import { GlazeDocs as App } from '@repo/glaze/docs/GlazeDocs';

const packageName = '@repo/glaze';
---

<BaseLayout
    title="@repo/glaze"
    description=""
    keywords=""
>
    <Hero
        badgeText="Project"
        title="@repo/glaze"
        description=""
        variant="ghost"
    />

    <section class="w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
