---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Hero } from '@repo/ui/data-display';
import PackageDoc from '../../components/api/PackageDoc.astro';

const packageName = '@repo/pixel-engine';
---

<BaseLayout
    title="Pixel Engine"
    description="Framework-agnostic image manipulation pipeline with fused transforms, tiled convolutions, and buffer management."
    keywords="image, pipeline, engine"
>
    <Hero
        badgeText="@repo/pixel-engine"
        title="Pixel Engine"
        description="Framework-agnostic image manipulation pipeline with fused transforms, tiled convolutions, and buffer management."
        variant="ghost"
    />

    <PackageDoc packageName={packageName} />
</BaseLayout>
