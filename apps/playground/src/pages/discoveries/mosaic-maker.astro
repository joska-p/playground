---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/ui/docs/api-reference/PackageDoc.astro';
import { App } from '@repo/mosaic-maker/mosaic-maker';

const packageName = '@repo/mosaic-maker';
---

<BaseLayout
    title="Mosaic Maker"
    description="Transform color palettes into beautiful procedural mosaic patterns using CSS Grid."
    keywords="generative, canvas, zustand"
>
    <section class="min-h-screen w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
