---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/api/PackageDoc.astro';
import { App } from '@repo/automa/automa';

const packageName = '@repo/automa';
---

<BaseLayout
    title="Automa"
    description="Interactive Conway's Game of Life simulator with Web Worker stepping, editable grid, and R3F orthographic rendering."
    keywords="simulation, three-js, webgl"
>
    <section class="w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
