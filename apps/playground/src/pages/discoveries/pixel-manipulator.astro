---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/ui/docs/api-reference/PackageDoc.astro';
import { App } from '@repo/pixel-manipulator/pixel-manipulator';

const packageName = '@repo/pixel-manipulator';
---

<BaseLayout
    title="Pixel Manipulator"
    description="A tool for manipulating images using canvas and web workers."
    keywords="image, canvas"
>
    <section class="min-h-screen w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
