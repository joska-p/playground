---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageDoc from '../../components/ui/docs/api-reference/PackageDoc.astro';
import { App } from '@repo/graph-viz/graph-viz';

const packageName = '@repo/graph-viz';
---

<BaseLayout
    title="Graphify"
    description="Interactive graph, click nodes, search, filter by community."
    keywords="data-viz, graph, d3"
>
    <section class="min-h-screen w-full">
        <App client:only="react" />
    </section>

    <PackageDoc packageName={packageName} />
</BaseLayout>
