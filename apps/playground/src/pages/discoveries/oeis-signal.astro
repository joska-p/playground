---
import { getEntry, render } from 'astro:content';
import DiscoveryLayout from '../../layouts/DiscoveryLayout.astro';
import { App } from '../../../../../packages/oeis-signal/src/App.tsx';
const entry = await getEntry('packages', 'oeis-signal');

if (!entry) {
    throw new Error(
        `Missing "packages" collection entry for "oeis-signal" — run \`pnpm generate-typedoc-json\` first.`
    );
}

const { Content } = await render(entry);
---

<DiscoveryLayout entry={entry}>
    <App
        slot="app"
        client:only="react"
    />
    <Content />
</DiscoveryLayout>
