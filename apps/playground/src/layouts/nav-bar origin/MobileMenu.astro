---
interface Route {
  label: string;
  href: string;
}

interface Props {
  routes: Route[];
  currentPath: string;
  baseUrl: string;
}

const { routes, currentPath, baseUrl } = Astro.props;

const isActive = (href: string): boolean => {
  if (href === baseUrl) {
    return currentPath === href || currentPath === href + '/';
  }
  return currentPath.startsWith(href);
};
---

<div
  class="border-border/50 bg-background/95 pointer-events-none absolute inset-x-0 top-full -z-10 flex origin-top -translate-y-4 flex-col gap-4 border-b px-6 py-8 opacity-0 shadow-[inset_0_1px_0_0_color-mix(in_srgb,var(--primary)_30%,transparent),0_30px_60px_-20px_color-mix(in_srgb,var(--primary)_25%,transparent),0_25px_50px_-12px_rgb(0_0_0/0.25)] backdrop-blur-xl transition-all duration-300 data-[open=true]:pointer-events-auto data-[open=true]:translate-y-0 data-[open=true]:opacity-100 md:hidden"
  data-open="false"
  id="mobile-menu"
>
  <nav
    aria-label="Mobile navigation"
    class="flex flex-col gap-2"
  >
    {
      routes.map((route) => {
        const active = isActive(route.href);
        return (
          <a
            aria-current={active ? 'page' : undefined}
            class="text-muted-foreground data-active:bg-primary/10 data-active:text-primary flex items-center rounded-xl px-4 py-3 text-sm font-bold uppercase transition-all active:scale-95 data-active:shadow-[0_0_16px_-4px_var(--primary)]"
            data-active={active ? '' : undefined}
            href={route.href}
          >
            {route.label}
          </a>
        );
      })
    }
  </nav>

  <div class="border-border/50 mt-4 flex gap-4 border-t pt-4">
    <a
      class="text-muted-foreground hover:text-primary flex items-center gap-2 text-xs"
      href="https://gitlab.com/joska-p/playground"
      rel="noopener noreferrer"
      target="_blank"
      >GitLab</a
    >

    <a
      class="text-muted-foreground hover:text-primary flex items-center gap-2 text-xs"
      href="https://github.com/joska-p/playground"
      rel="noopener noreferrer"
      target="_blank"
      >GitHub</a
    >
  </div>
</div>
