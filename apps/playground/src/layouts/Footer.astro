---
import { Icon, type IconName } from '@repo/tlc/components/icons';
const baseUrl = import.meta.env.BASE_URL || '/';
const { class: className } = Astro.props;

type Route = {
    label: string;
    href: string;
    iconName: IconName;
};

const routes = [
    { label: 'Github', href: 'https://github.com/joska-p/playground', iconName: 'github' },
    { label: 'Storybook', href: `${baseUrl}storybook/`, iconName: 'storybook' },
    { label: 'Docs', href: `${baseUrl}docs/`, iconName: 'book' }
] as const satisfies Route[];
---

<footer class:list={['w-full py-8', className]}>
    <div
        class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-6 md:flex-row lg:px-8"
    >
        <!-- Left: Copyright + Bundle -->
        <div class="text-foreground-dim/50 flex items-center gap-3 text-xs">
            <span>© {new Date().getFullYear()} PG_LAB</span>
            <span class="text-foreground-dim/20">·</span>
            <a
                href={`${baseUrl}stats.html`}
                class="hover:text-primary transition-colors"
            >
                Bundle
            </a>
        </div>

        <!-- Right: Links -->
        <nav
            aria-label="Footer navigation"
            class="flex items-center gap-6"
        >
            {
                routes.map((link) => (
                    <a
                        class="text-foreground-dim/60 hover:text-primary flex items-center gap-2 text-xs font-medium transition-colors"
                        href={link.href}
                        rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                        target={link.href.startsWith('http') ? '_blank' : undefined}
                    >
                        <Icon name={link.iconName} />
                        {link.label}
                    </a>
                ))
            }
        </nav>
    </div>
</footer>
