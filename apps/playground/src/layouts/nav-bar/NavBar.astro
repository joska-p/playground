---
import NavLogo from './NavLogo.astro';
import NavLinks from './NavLinks.astro';
import NavActions from './NavActions.astro';
import MobileMenu from './MobileMenu.astro';

const currentPath = Astro.url.pathname;
const baseUrl = import.meta.env.BASE_URL || '/';

const routes = [
    { label: '~/home', href: `${baseUrl}#home` },
    { label: '~/discoveries', href: `${baseUrl}#discoveries` },
    { label: '~/notes', href: `${baseUrl}#notes` },
    { label: '~/docs', href: `${baseUrl}#documents` }
];
---

<header
    class="pointer-events-none sticky top-0 z-50 mx-auto max-w-3xl min-w-fit transition-all duration-300 data-[hidden=true]:pointer-events-none data-[hidden=true]:-translate-y-[110%] data-[hidden=true]:opacity-0 md:top-4 md:px-6"
>
    <div
        class="border-border bg-surface/40 shadow-glow-color/35 relative z-30 mx-auto flex h-14 max-w-7xl items-center justify-between border-b px-4 backdrop-blur-md transition-all duration-300 md:rounded-full md:border"
    >
        <NavLogo href={baseUrl} />
        <NavLinks
            baseUrl={baseUrl}
            currentPath={currentPath}
            routes={routes}
        />
        <NavActions />
    </div>

    <MobileMenu
        baseUrl={baseUrl}
        currentPath={currentPath}
        routes={routes}
    />
</header>

<!-- Bundled scripts: Astro deduplicates these automatically -->
<script>
    import './scripts/theme.js';
    import './scripts/mobileMenu.js';
    import './scripts/smartNavbar.js';
</script>
