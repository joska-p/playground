---
import { isActiveRoute, socialLinks, type Route } from './navUtils';

interface Props {
    routes: Route[];
    currentPath: string;
    baseUrl: string;
}

const { routes, currentPath, baseUrl } = Astro.props;
---

<div
    class="border-border bg-background/95 shadow-glow-rest pointer-events-none absolute inset-x-0 top-full -z-10 flex origin-top -translate-y-4 scale-y-0 flex-col gap-4 border-b px-6 py-8 opacity-0 backdrop-blur-xl transition-all duration-300 data-[open=true]:pointer-events-auto data-[open=true]:translate-y-0 data-[open=true]:scale-y-100 data-[open=true]:opacity-100 md:hidden"
    data-open="false"
    id="mobile-menu"
>
    <nav
        aria-label="Mobile navigation"
        class="flex flex-col gap-2"
    >
        {
            routes.map((route) => {
                const active = isActiveRoute(route.href, currentPath, baseUrl);
                return (
                    <a
                        aria-current={active ? 'page' : undefined}
                        class="text-foreground-muted data-active:bg-glow-subtle data-active:text-glow data-active:shadow-glow-rest pointer-events-auto flex items-center rounded-xl px-4 py-3 text-sm font-bold uppercase transition-all active:scale-95"
                        data-active={active ? '' : undefined}
                        href={route.href}
                    >
                        {route.label}
                    </a>
                );
            })
        }
    </nav>

    <div class="border-border mt-4 flex gap-4 border-t pt-4">
        {
            socialLinks.map((link) => (
                <a
                    class="text-foreground-muted hover:text-glow pointer-events-auto flex items-center gap-2 text-xs"
                    href={link.href}
                    rel="noopener noreferrer"
                    target="_blank"
                >
                    {link.label}
                </a>
            ))
        }
    </div>
</div>
