---
import { toCanadianSyllabics } from '../../utils/format';

const logoTitle = toCanadianSyllabics.fromHash('PG_LAB');

type Props = {
    href: string;
};
const { href } = Astro.props;
---

<a
    aria-label="Playground home"
    class="group text-foreground pointer-events-auto flex items-center gap-2 text-xs font-bold transition-all duration-300"
    href={href}
>
    <span
        aria-hidden="true"
        class="relative flex h-6 w-6 items-center justify-center"
    >
        <span
            class="absolute inset-0 animate-ping rounded-full border-2 border-(--glow-color) bg-(--glow-color) opacity-30"
        ></span>
        <span
            class="relative flex h-3 w-3 items-center justify-center rounded-full border-3 border-transparent bg-(--glow-color) shadow-[0_0_8px_1px_var(--glow-color)] transition-all duration-300 group-hover:scale-110 group-hover:shadow-[0_0_16px_3px_var(--glow-color)]"
        ></span>
    </span>
    {logoTitle}
</a>
