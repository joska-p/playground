---
import { Icon } from '@repo/ui/icons';
import { githubUrl } from './navUtils';

// Shared chrome for the circular action buttons below (GitHub link + theme toggle).
// The burger button is visually distinct enough (shape, hover shadow) that it keeps its own class string.
const iconButtonClasses =
    'bg-surface-raised/50 text-foreground-muted hover:text-glow pointer-events-auto flex h-8 w-8 items-center justify-center rounded-full border-2 border-transparent transition-all duration-200 hover:shadow-glow-hover focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none active:scale-[.97]';
---

<div class="flex items-center gap-2">
    <!-- Social links (desktop only) -->
    <div class="hidden items-center gap-2 md:flex">
        <a
            aria-label="GitHub"
            class={iconButtonClasses}
            href={githubUrl}
            rel="noopener noreferrer"
            target="_blank"
        >
            <Icon
                className="h-3.5 w-3.5"
                name="github"
            />
        </a>
    </div>

    <!-- Theme toggle -->
    <button
        aria-label="Toggle theme"
        class={`${iconButtonClasses} hover:bg-glow-subtle`}
        id="theme-toggle"
    >
        <svg
            fill="none"
            height="14"
            id="icon-sun"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
        >
            <circle
                cx="12"
                cy="12"
                r="4"
            ></circle>
            <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                stroke-dasharray="none"
            ></path>
        </svg>
        <svg
            fill="none"
            height="14"
            id="icon-moon"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"></path>
        </svg>
    </button>

    <!-- Mobile burger button -->
    <button
        aria-expanded="false"
        aria-label="Toggle menu"
        class="bg-surface-raised/50 text-foreground-muted hover:shadow-glow-hover focus-visible:ring-primary pointer-events-auto flex h-8 w-8 flex-col items-center justify-center gap-1.5 rounded-full transition-all duration-200 focus-visible:ring-2 focus-visible:outline-none active:scale-[.97] md:hidden"
        id="mobile-menu-toggle"
    >
        <span
            class="h-0.5 w-4 rounded-full bg-current transition-transform duration-300"
            id="burger-top"
        ></span>
        <span
            class="h-0.5 w-4 rounded-full bg-current transition-all duration-300"
            id="burger-bottom"
        ></span>
    </button>

    <style>
        html[data-theme='dark'] #icon-moon {
            display: none;
        }
        html[data-theme='light'] #icon-sun {
            display: none;
        }

        #mobile-menu-toggle[aria-expanded='true'] #burger-top {
            transform: translateY(4px) rotate(45deg);
        }
        #mobile-menu-toggle[aria-expanded='true'] #burger-bottom {
            transform: translateY(-4px) rotate(-45deg);
        }
    </style>
</div>
