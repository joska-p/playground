{
    "name": "@repo/storybook",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "storybook build && pnpm run copy:storybook-static",
        "check-types": "tsc -b",
        "clean": "rm -rf node_modules storybook-static dist .turbo",
        "copy:storybook-static": "mkdir -p ../../apps/playground/dist/storybook && cp -r ./storybook-static/. ../../apps/playground/dist/storybook",
        "dev": "storybook dev -p 6006",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix"
    },
    "dependencies": {
        "@chromatic-com/storybook": "^5.3.0",
        "@repo/tlc": "workspace:*",
        "@storybook/addon-a11y": "^10.5.10",
        "@storybook/addon-docs": "^10.5.10",
        "lucide-react": "^1.23.0",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@babel/core": "catalog:",
        "@eslint/js": "catalog:",
        "@repo/config-typescript": "workspace:*",
        "@rolldown/plugin-babel": "catalog:",
        "@storybook/addon-mcp": "^0.7.0",
        "@storybook/addon-themes": "^10.5.10",
        "@storybook/addon-vitest": "^10.5.10",
        "@storybook/react-vite": "^10.5.10",
        "@tailwindcss/vite": "catalog:",
        "@tsconfig/strictest": "catalog:",
        "@types/babel__core": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "babel-plugin-react-compiler": "catalog:",
        "eslint": "catalog:",
        "eslint-plugin-react-hooks": "catalog:",
        "eslint-plugin-react-refresh": "catalog:",
        "eslint-plugin-storybook": "^10.5.10",
        "globals": "catalog:",
        "playwright": "^1.60.0",
        "storybook": "^10.5.10",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
